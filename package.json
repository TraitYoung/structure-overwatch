{
  "name": "structure-survallian",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "concurrently -n server,web -c blue,green \"pnpm --filter @surv/server dev\" \"pnpm --filter @surv/web dev\"",
    "demo": "pnpm --filter @surv/server demo",
    "test": "pnpm -r test",
    "watch": "pnpm --filter @surv/server cli -- watch"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  }
}
